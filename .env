# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ============================================
# Application Settings
# ============================================
APP_TITLE=SIH Local LLM Assistant
APP_VERSION=3.0.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=sih_documents

# ============================================
# Embedding Model
# ============================================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ============================================
# Chunking Settings
# ============================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ============================================
# RAG Settings
# ============================================
RAG_TOP_K=5

# ============================================
# Upload Settings
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ============================================
# Tesseract OCR (Windows)
# ============================================
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ============================================
# Step 3: Agentic Workflow (LangGraph)
# ============================================
SANDBOX_DIR=sandbox
WORKSPACE_DIR=workspace
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120

# ============================================
# Databricks / Delta Lake (optional)
# ============================================
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# ============================================
# JWT / Authentication
# ============================================
JWT_SECRET_KEY=eurekax-super-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
